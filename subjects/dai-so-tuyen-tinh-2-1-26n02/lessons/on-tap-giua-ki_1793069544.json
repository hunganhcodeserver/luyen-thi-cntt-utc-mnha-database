        "questions": [
          {
            "startLine": 1,
            "text": "Kí hiệu $A$, $\\bar{A}$ lần lượt là ma trận hệ số và ma trận hệ số mở rộng của một hệ phương trình tuyến tính $Ax=b$. Khẳng định nào dưới đây là Đúng:",
            "image": null,
            "options": [
              {
                "key": "A",
                "text": "$r(A)\\le r(\\bar{A})$"
              },
              {
                "key": "B",
                "text": "$r(A)\\ne r(\\bar{A})$"
              },
              {
                "key": "C",
                "text": "$r(A)<r(\\bar{A})$"
              },
              {
                "key": "D",
                "text": "$r(A)>r(\\bar{A})$"
              }
            ],
            "correct": [
              "A"
            ],
            "explanationHtml": "Ma trận mở rộng có thêm cột $b$ nên $r(A)\\le r(\\bar{A})$ luôn đúng.",
            "multi": false,
            "id": "mcq-1",
            "clusterId": null
          },
          {
            "startLine": 8,
            "text": "Cho $A$, $B$ vuông cùng cấp. Khi đó $(A^4B^3-3A^3B^3)$ phân tích được thành:",
            "image": null,
            "options": [
              {
                "key": "A",
                "text": "$A^3(A-3I)B^3$"
              },
              {
                "key": "B",
                "text": "$A^3B^3(A-3I)$"
              },
              {
                "key": "C",
                "text": "Không có đáp án nào đúng"
              },
              {
                "key": "D",
                "text": "$A^3(A-3)B^3$"
              },
              {
                "key": "E",
                "text": "$A^3B^3(A-3)$"
              }
            ],
            "correct": [
              "A"
            ],
            "explanationHtml": "Đặt $A^3$ ở bên trái, $B^3$ ở bên phải (ma trận không giao hoán): $A^4B^3-3A^3B^3=A^3(A-3I)B^3$.",
            "multi": false,
            "id": "mcq-2",
            "clusterId": null
          },
          {
            "startLine": 16,
            "text": "Cho ma trận $B$ cỡ $4\\times 5$ và tích $AB$ có cỡ $3\\times 5$. Kích thước của ma trận $A$ là:",
