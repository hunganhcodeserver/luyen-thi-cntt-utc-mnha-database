          {
            "startLine": 1,
            "text": "Cho các ma trận $A=\\begin{pmatrix}1&2\\\\-1&-1\\end{pmatrix}$, $B=\\begin{pmatrix}2&1\\\\2&1\\end{pmatrix}$. Khi đó ma trận $(A+B)^2-2AB$ là",
            "image": null,
            "options": [
              {
                "key": "A",
                "text": "$\\begin{pmatrix}-2&-3\\\\9&1\\end{pmatrix}$"
              },
              {
                "key": "B",
                "text": "$\\begin{pmatrix}-9&-3\\\\9&4\\end{pmatrix}$"
              },
              {
                "key": "C",
                "text": "$\\begin{pmatrix}5&3\\\\6&2\\end{pmatrix}$"
              },
              {
                "key": "D",
                "text": "$\\begin{pmatrix}0&3\\\\11&7\\end{pmatrix}$"
              }
            ],
            "correct": [
              "D"
            ],
            "explanationHtml": "$(A+B)^2-2AB=\\begin{pmatrix}0&amp;3\\\\11&amp;7\\end{pmatrix}$.",
            "multi": false,
            "id": "mcq-1",
            "clusterId": null
          },
          {
            "startLine": 8,
            "text": "Cho ma trận $A=\\begin{pmatrix}3&-1\\\\2&-1\\end{pmatrix}$. Nghiệm của phương trình ma trận $AX=A^3+3I$ là",
            "image": null,
            "options": [
              {
                "key": "A",
                "text": "$X=\\begin{pmatrix}10&-5\\\\10&-10\\end{pmatrix}$"
              },
              {
                "key": "B",
                "text": "$X=\\begin{pmatrix}8&-3\\\\6&-4\\end{pmatrix}$"
              },
              {
                "key": "C",
                "text": "$X=\\begin{pmatrix}12&-2\\\\10&-8\\end{pmatrix}$"
              },
              {
                "key": "D",
                "text": "$X=\\begin{pmatrix}10&4\\\\1&-10\\end{pmatrix}$"
              }
            ],
            "correct": [
              "A"
            ],
            "explanationHtml": "$X=A^{-1}(A^3+3I)=A^2+3A^{-1}=\\begin{pmatrix}10&amp;-5\\\\10&amp;-10\\end{pmatrix}$.",
            "multi": false,
            "id": "mcq-2",
            "clusterId": null
          },
